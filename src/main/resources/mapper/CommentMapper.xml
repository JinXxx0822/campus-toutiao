<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.toutiao.dao.CommentMapper">

    <resultMap id="commentMap" type="com.campus.toutiao.entity.Comment">
        <id property="id" column="id"/>
        <result property="content" column="content"/>
        <result property="userId" column="user_id"/>
        <result property="articleId" column="article_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="createTime" column="create_time"/>
        <result property="userName" column="user_name"/>
        <result property="userAvatar" column="user_avatar"/>
    </resultMap>

    <select id="findByArticleId" parameterType="int" resultMap="commentMap">
        SELECT c.*, u.nickname as user_name, u.avatar as user_avatar
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        WHERE c.article_id = #{articleId}
        ORDER BY c.create_time DESC
    </select>

    <insert id="insert" parameterType="com.campus.toutiao.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment (content, user_id, article_id, parent_id)
        VALUES (#{content}, #{userId}, #{articleId}, #{parentId})
    </insert>

    <delete id="delete" parameterType="int">
        DELETE FROM comment WHERE id = #{id}
    </delete>

    <select id="countByArticleId" parameterType="int" resultType="int">
        SELECT COUNT(*) FROM comment WHERE article_id = #{articleId}
    </select>

</mapper>
